# Axon CLI - local development environment
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# HOW THIS FILE IS LOADED
#   `.env` is read automatically only by local dev runs (`bun run dev -- pi`),
#   because Bun autoloads dotenv. Compiled binaries are built with
#   --no-compile-autoload-dotenv and ignore project env files, so an installed
#   `axon` gets these values from the shell environment (or the build-time
#   service origin) instead.
#
# `.env` is git-ignored. Never commit real keys; keep placeholders here.
#
# Variable names follow their owner: AXON_* / PI_AXON_* are product-specific.
# Keep standard PI_*, LITELLM_*, OTEL_*, and GOOGLE_* names unchanged.
#
# Only the values you actually want are needed. Everything below except
# AXON_SERVICE_ORIGIN is commented out on purpose: an unconfigured `.env`
# leaves LiteLLM auth to Pi's `/login` flow and the telemetry extension inert.

# ---------------------------------------------------------------------------
# Axon service origin (required for local development)
# ---------------------------------------------------------------------------
# Shared origin for the installer and CLI service endpoints.
# Local development may use loopback HTTP. Staging and production must use HTTPS.
# Do not include a path, query, fragment, credentials, or trailing slash.
AXON_SERVICE_ORIGIN=http://localhost:0

# ---------------------------------------------------------------------------
# Pi model recommendation (optional)
# ---------------------------------------------------------------------------
# Managed axon launches route recommendations through the authenticated relay
# to AXON_SERVICE_ORIGIN; an explicit URL below is overridden.
# Set the URL only when loading the extension outside the managed launcher.
# PI_MODEL_RECOMMENDER_URL=http://localhost:3000/api/v1/model-recommendations
# Optional bearer credential if the recommendation endpoint requires one.
# PI_MODEL_RECOMMENDER_API_KEY=replace-me
# Backend request timeout in milliseconds (default 5000).
# PI_MODEL_RECOMMENDER_TIMEOUT_MS=5000
# Delay before the top recommendation is selected automatically (default 10000).
# PI_MODEL_RECOMMENDER_AUTO_SELECT_MS=10000
# Disable recommendation for the first interactive task (1 = disabled).
# PI_MODEL_RECOMMENDER_DISABLED=1

# ---------------------------------------------------------------------------
# Axon launcher overrides (optional)
# ---------------------------------------------------------------------------
# Isolated state directory. Defaults to ~/.axon.
# AXON_HOME=/absolute/path/to/axon-home
# Print a redacted launch preview and diagnostic error causes on stderr.
# AXON_DEBUG=1
# Disable best-effort post-session background binary updates (manual axon update still works).
# AXON_NO_UPDATE=1
# AXON_PI_BIN is rejected: Axon always uses its pinned managed Pi executable.
# Source-development version override only; compiled binaries reject a different pin.
# AXON_PI_VERSION=1.1.0

# ---------------------------------------------------------------------------
# LiteLLM provider (organization provider path)
# ---------------------------------------------------------------------------
# These options configure the pinned `pi-provider-litellm` extension inside
# the harness. Axon preserves explicit display names and supplies a default
# when unset. Ordinary managed sessions override the base URL and API key with
# a per-launch authenticated loopback relay. Pi uses an isolated agent dir:
# config lives in ~/.axon/pi/settings.json and saved auth in ~/.axon/pi/auth.json.
# For direct provider usage, a saved `/login litellm` credential wins over
# LITELLM_API_KEY.
#
# Default provider UI label (Axon supplies "Axon AI Gateway" when unset).
# litellm.providers.litellm.displayName in settings wins; aliases are unaffected.
# Explicit values are forwarded unchanged; an empty value restores "LiteLLM".
# LITELLM_DISPLAY_NAME="Company AI Gateway"
#
# Proxy URL, with or without a trailing /v1. Required before first login.
# LITELLM_BASE_URL=https://litellm.example.com
# Bearer key used when no saved `/login litellm` credential exists.
# LITELLM_API_KEY=sk-replace-me
# Command that prints a fresh bearer token. Takes precedence over the key above
# and is re-run per request, so short-lived/rotating tokens stay fresh.
# LITELLM_API_KEY_HELPER=/absolute/path/to/print-token
# JSON object of extra headers for provider, discovery, MCP, and Skills calls.
# LITELLM_HEADERS={"x-organization":"example"}
# Discovery request timeout in ms (default 5000; the activation seed caps at 3000).
# LITELLM_DISCOVERY_TIMEOUT_MS=5000
# Lifetime of CLI-issued virtual keys in hours (default 24).
# LITELLM_CLI_JWT_EXPIRATION_HOURS=24
# Skip all LiteLLM discovery network access (1 = on).
# LITELLM_OFFLINE=1
# Log verbose discovery diagnostics (1 = on).
# LITELLM_VERBOSE_DISCOVERY=1
# Use Google Application Default Credentials as the bearer token (any value but 0).
# LITELLM_GCLOUD_TOKEN_AUTH=1
# Only needed for the Google ADC path; kept by axon and never forwarded to Pi.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json

# ---------------------------------------------------------------------------
# Standalone web search (embedded Pi extension)
# ---------------------------------------------------------------------------
# Managed axon launches always use the authenticated /litellm/v1/chat/completions
# relay. Backend WEB_SEARCH config supplies non-secret preferences; it never
# supplies URLs, keys, or identity. LiteLLM owns authorization and budgets.
# Local disablement/offline wins; numeric limits can be lowered. Fetched backend
# generation/grounding defaults override the corresponding environment settings.
# PI_WEB_SEARCH_ENABLED=false
# PI_WEB_SEARCH_MODEL=gemini-3.8-flash
# PI_WEB_SEARCH_TIMEOUT_MS=60000
# PI_WEB_SEARCH_MAX_QUERY_CHARACTERS=20000
# PI_WEB_SEARCH_MAX_RESULT_CHARACTERS=30000
# PI_WEB_SEARCH_MAX_OUTPUT_TOKENS=8192
# PI_WEB_SEARCH_MAX_SOURCES=20
# PI_WEB_SEARCH_TEMPERATURE=1
# Optional reasoning override: low / medium / high; unset = model default.
# PI_WEB_SEARCH_THINKING_LEVEL=low
# Optional unified search setting: Gemini ignores this in LiteLLM 1.104.0.
# PI_WEB_SEARCH_SEARCH_CONTEXT_SIZE=medium
# Gemini-specific optional URL-context tool.
# PI_WEB_SEARCH_USE_URL_CONTEXT=false
# PI_WEB_SEARCH_REQUIRE_GROUNDING=true
# Extension-owned prompt override; the current UTC date is appended.
# PI_WEB_SEARCH_SYSTEM_PROMPT=Search official sources and cite them.
#
# Plain Pi only: current /login LiteLLM credentials and headers are resolved per
# call. Select a provider alias, or explicitly pair an endpoint with its own key.
# Managed launches override endpoint/key below with the relay capability.
# PI_WEB_SEARCH_PROVIDER=litellm
# PI_WEB_SEARCH_BASE_URL=https://litellm.example.com/v1
# PI_WEB_SEARCH_URL=https://litellm.example.com/v1/chat/completions
# PI_WEB_SEARCH_API_KEY=sk-replace-me
# PI_WEB_SEARCH_MODE and PI_WEB_SEARCH_SEARCH_TOOL are no longer used.

# ---------------------------------------------------------------------------
# Organization telemetry (OTLP export from the embedded Pi extension)
# ---------------------------------------------------------------------------
# Consumed by the embedded `pi-org-telemetry` extension. It stays completely
# inert unless an endpoint is configured. Export failures are passive and
# bounded; prompt/completion text, file contents, headers, and env values are
# never exported.
#
# Enablement requires OTEL_EXPORTER_OTLP_ENDPOINT *or* all three per-signal
# *_TRACES/METRICS/LOGS_ENDPOINT variables. A single per-signal endpoint alone
# does not enable telemetry.
#
# Global collector endpoint (http/protobuf: :4318, gRPC: :4317).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# Transport: "http/protobuf" (default) or "grpc"; selects the exporter class.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Extra headers, URI-encoded (for example authorization=Bearer%20TOKEN).
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20REPLACE_ME
# Optional per-signal endpoints; set all three to enable without the global one.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://collector.example.com/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://collector.example.com/v1/logs
# Resource identity reported with every signal.
# Axon service label; the standalone extension defaults to pi-coding-agent.
# OTEL_SERVICE_NAME=axon-cli
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=developer-tools
# Sampling: always_off / traceidratio / parentbased_traceidratio (default: always on).
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Metric export interval in ms, bounded 1000..300000 (default 10000).
# OTEL_METRIC_EXPORT_INTERVAL=10000
# Batch knobs, bounded by the extension. OTEL_BLRP_* (logs) falls back to
# OTEL_BSP_* and then to managed defaults.
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
# OTEL_BSP_SCHEDULE_DELAY=1000
# OTEL_BSP_EXPORT_TIMEOUT=3000
# Emergency kill switch (0/false/no disables all export).
# PI_ORG_OTEL_ENABLED=false
# Suppress rate-limited local stderr diagnostics (0/false/no).
# PI_ORG_OTEL_DIAGNOSTICS=false

# ---------------------------------------------------------------------------
# Ambient provider credentials are intentionally NOT listed here
# ---------------------------------------------------------------------------
# axon strips Pi's documented personal provider keys (ANTHROPIC_API_KEY,
# OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, XAI_API_KEY, ...) from the
# harness environment so ambient personal credentials never select a provider.
# Do not reintroduce them through this file.

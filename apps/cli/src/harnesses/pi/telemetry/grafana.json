{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Metrics populated from OTLP",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Traces populated from OTLP",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Interactions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_interaction_count_total{user_email=~\"$user\",pi_repo_slug=~\"$repo\"}[$__range]))",
          "legendFormat": "Interactions"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Repeated agent runs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_agent_run_repeated_total{user_email=~\"$user\",pi_repo_slug=~\"$repo\"}[$__range]))",
          "legendFormat": "Repeated runs"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "LLM errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_llm_errors_total{user_email=~\"$user\"}[$__range])) or vector(0)",
          "legendFormat": "LLM errors"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Tool errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_tool_errors_total{user_email=~\"$user\"}[$__range])) or vector(0)",
          "legendFormat": "Tool errors"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Input tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_tokens_input_total{user_email=~\"$user\"}[$__range]))",
          "legendFormat": "Input tokens"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Output tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_tokens_output_total{user_email=~\"$user\"}[$__range]))",
          "legendFormat": "Output tokens"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Operational rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pi_interaction_count_total{user_email=~\"$user\",pi_repo_slug=~\"$repo\"}[5m])) by (user_email)",
          "legendFormat": "{{user_email}} interactions"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pi_turn_count_total{user_email=~\"$user\",pi_repo_slug=~\"$repo\"}[5m])) by (user_email)",
          "legendFormat": "{{user_email}} turns"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pi_tool_calls_total{user_email=~\"$user\"}[5m])) by (user_email)",
          "legendFormat": "{{user_email}} tools"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(pi_interaction_duration_seconds_bucket{user_email=~\"$user\",pi_repo_slug=~\"$repo\"}[5m])) by (le))",
          "legendFormat": "Interaction"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(pi_llm_duration_seconds_bucket{user_email=~\"$user\"}[5m])) by (le))",
          "legendFormat": "LLM"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum(rate(pi_tool_duration_seconds_bucket{user_email=~\"$user\"}[5m])) by (le))",
          "legendFormat": "Tool"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "User interventions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_user_intervention_count_total{user_email=~\"$user\",pi_repo_slug=~\"$repo\"}[$__range])) by (kind)",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "table",
      "title": "Recent interaction traces",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"invoke_agent pi\" && resource.\"user.email\" =~ \"$user\" && span.\"pi.repo.slug\" =~ \"$repo\" }",
          "limit": 50
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "title": "Context utilization p95 (by model)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(pi_context_utilization_percent_bucket{user_email=~\"$user\"}[5m])) by (le, gen_ai_request_model))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cost by model and usage source",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_cost_USD_total{user_email=~\"$user\"}[$__range])) by (gen_ai_response_model, pi_usage_source)",
          "legendFormat": "{{gen_ai_response_model}} ({{pi_usage_source}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Token mix",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pi_tokens_input_total{user_email=~\"$user\"}[5m]))",
          "legendFormat": "input"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pi_tokens_output_total{user_email=~\"$user\"}[5m]))",
          "legendFormat": "output"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pi_tokens_reasoning_total{user_email=~\"$user\"}[5m]))",
          "legendFormat": "reasoning"
        },
        {
          "refId": "D",
          "expr": "sum(rate(pi_tokens_cache_read_total{user_email=~\"$user\"}[5m]))",
          "legendFormat": "cache read"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Telemetry health",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_telemetry_export_errors_total{user_email=~\"$user\"}[5m])) by (otel_signal) or vector(0)",
          "legendFormat": "export errors {{otel_signal}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(pi_telemetry_dropped_total{user_email=~\"$user\"}[5m])) by (otel_signal, reason) or vector(0)",
          "legendFormat": "dropped {{otel_signal}} {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum(increase(pi_llm_truncated_total{user_email=~\"$user\"}[5m])) or vector(0)",
          "legendFormat": "truncated responses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "Active users",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (user_email) (increase(pi_interaction_count_total{user_email=~\"$user\"}[$__range])) > 0) or vector(0)",
          "legendFormat": "Active users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "Session starts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_session_started_total{user_email=~\"$user\"}[$__range])) or vector(0)",
          "legendFormat": "Session starts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "Total estimated cost",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pi_cost_USD_total{user_email=~\"$user\"}[$__range])) or vector(0)",
          "legendFormat": "Estimated cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "gauge",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pi_tokens_cache_read_total{user_email=~\"$user\"}[$__rate_interval])) / (sum(rate(pi_tokens_input_total{user_email=~\"$user\"}[$__rate_interval])) + sum(rate(pi_tokens_cache_read_total{user_email=~\"$user\"}[$__rate_interval])) + sum(rate(pi_tokens_cache_write_total{user_email=~\"$user\"}[$__rate_interval])))",
          "legendFormat": "Cache hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Top users by estimated cost",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (user_email) (increase(pi_cost_USD_total{user_email=~\"$user\"}[$__range])))",
          "legendFormat": "{{user_email}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "CLI version adoption",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (deputydev_cli_version) (max by (user_email, deputydev_cli_version) (max_over_time(deputydev_release_events_total{user_email=~\"$user\",component=\"cli\",stage=\"launch\"}[$__range])) > 0)",
          "legendFormat": "{{deputydev_cli_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Model recommender funnel",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 61
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, outcome) (increase(deputydev_recommender_events_total{user_email=~\"$user\",component=\"cli\"}[$__range]))",
          "legendFormat": "{{stage}} · {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Model recommender selections",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 61
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, selected_rank, outcome) (increase(deputydev_recommender_events_total{user_email=~\"$user\",component=\"cli\",stage=\"decision\"}[$__range]))",
          "legendFormat": "{{model}} · rank {{selected_rank}} · {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Model recommender request p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 69
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, component) (rate(deputydev_recommender_duration_seconds_bucket{user_email=~\"$user\",stage=\"request\"}[$__rate_interval])))",
          "legendFormat": "{{component}} request"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Task assessment distributions",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 69
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(deputydev_recommender_complexity_bucket{user_email=~\"$user\",component=\"cli\"}[$__rate_interval])))",
          "legendFormat": "Complexity p50 (0–3)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(deputydev_recommender_confidence_bucket{user_email=~\"$user\",component=\"cli\"}[$__rate_interval])))",
          "legendFormat": "Confidence p50 (0–1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Recommender skips and failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 77
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, reason) (increase(deputydev_recommender_events_total{user_email=~\"$user\",component=\"cli\",outcome=~\"failed|skipped|cancelled\"}[$__range]))",
          "legendFormat": "{{stage}} · {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Recommended model overrides",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
